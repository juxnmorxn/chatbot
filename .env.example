PORT=3000
NODE_ENV=production

# ==============================================================================
# BASE DE DATOS PRINCIPAL (Turso libSQL Cloud)
# Solo se requiere esta conexión para arrancar. Todas las demás configuraciones
# (Evolution API, Groq IA, WispHub, SmartOLT, Pagos, etc.) se gestionan
# dinámicamente desde el Panel Web Administrativo (/admin) y se guardan en Turso.
# ==============================================================================
TURSO_DATABASE_URL=libsql://tu-db-aqui.turso.io
TURSO_AUTH_TOKEN=tu-token-jwt-de-turso
