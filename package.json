{
  "name": "chatbot-isp",
  "version": "1.0.0",
  "description": "Chatbot WhatsApp inteligente para ISP con Express, TypeScript, Base de Datos Local, Groq y Evolution API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --packages=external --format=esm --target=node22 --outfile=dist/server.js",
    "start": "node dist/server.js",
    "preview": "node dist/server.js",
    "deploy": "node scripts/deploy-hostinger.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:local_db": "tsx src/scripts/test-db.ts",
    "test:groq": "tsx src/scripts/test-groq.ts",
    "test:tickets": "tsx src/scripts/test-tickets.ts"
  },
  "author": "juxnmorxn",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@vitejs/plugin-react": "^6.1.1",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "ssh2": "^1.17.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
